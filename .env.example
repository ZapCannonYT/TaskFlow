# Supabase project URL and publishable key. Safe for browser use when RLS is enabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Public VAPID key used by Chrome to create a push subscription.
# The matching private key must stay in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Development safety: the Dev Panel warns when its configured Supabase host is this value.
VITE_PRODUCTION_SUPABASE_HOST=your-production-project.supabase.co

# Service workers are disabled in ordinary local development. Set to true only to test one.
VITE_ENABLE_SW=false

# Optional static host for on-device speech model files. Leave empty to use Hugging Face.
# Expected layout: <host>/onnx-community/<model-id>/<file-path>
VITE_VOICE_MODEL_HOST=

# Legacy projects may use the anon key instead. Prefer the publishable key above.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Server-only Phase 3 values (set these in Supabase, never in .env or Cloudflare):
# TASKFLOW_VAPID_PUBLIC_KEY=your-vapid-public-key
# TASKFLOW_VAPID_PRIVATE_KEY=your-vapid-private-key
# TASKFLOW_VAPID_SUBJECT=mailto:you@example.com
# TASKFLOW_DISPATCH_SECRET=long-random-secret
