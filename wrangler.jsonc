{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskflow",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/voice-model/*", "/api/*"],
    "not_found_handling": "single-page-application"
  },
  // Workers AI runs Whisper for voice capture (free daily allowance on the Workers plan).
  "ai": { "binding": "AI" },
  // Public values, already shipped in the browser bundle; used to verify the caller's session.
  "vars": {
    "SUPABASE_URL": "https://jpfbuoizwhlzxhpjouub.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_mdup2EGzRYcN899AdRNyjg_POPx3SJv"
  },
  // Previews do not inherit `ai` or `vars`, so repeat them here or voice falls back to on-device.
  "previews": {
    "ai": { "binding": "AI" },
    "vars": {
      "SUPABASE_URL": "https://jpfbuoizwhlzxhpjouub.supabase.co",
      "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_mdup2EGzRYcN899AdRNyjg_POPx3SJv"
    }
  }
}
