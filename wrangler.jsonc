{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskflow",
  "main": "src/cloudflare-worker.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/voice-model/*"],
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
