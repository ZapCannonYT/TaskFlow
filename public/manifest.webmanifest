{
  "id": "/",
  "name": "Taskflow",
  "short_name": "Taskflow",
  "description": "A quiet place to capture and manage tasks.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "share_target": {
    "action": "/?share=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [{ "name": "Add by voice", "short_name": "Voice task", "description": "Capture a task by speaking", "url": "/?capture=voice", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }],
  "background_color": "#ECEBE6",
  "theme_color": "#ECEBE6",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
